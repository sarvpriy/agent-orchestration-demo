# Copy to .env and fill in. Both the Python API (agent2) and the Node app read it.

# Groq key used by the classifier (Node) and by /classify-and-retrieve (Python)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Where the Node app finds the Python knowledge-retrieval service
KNOWLEDGE_RETRIEVAL_AGENT_URL=http://127.0.0.1:8000/retrieve

# Optional: override the OpenAI-compatible LLM endpoint (defaults to Groq)
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Ticketing (served by the same Python API)
# TICKET_AGENT_URL=http://127.0.0.1:8000/tickets/find-or-create   # default: derived from KNOWLEDGE_RETRIEVAL_AGENT_URL
# TICKETS_DB=data/tickets.db                                      # SQLite file
# TICKET_DUP_THRESHOLD=0.80                                       # similarity needed to reuse an open ticket
